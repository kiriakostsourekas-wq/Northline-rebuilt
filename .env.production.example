# Future production environment template for the new Northline rebuild.
# Do not attach this to the live northline.ai project until a launch/cutover
# task is explicitly approved.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/northline_production?schema=public"
NEXT_PUBLIC_APP_URL="https://<future-production-domain>"

# Required in strict production. Used to verify signed website-chat webhooks.
NORTHLINE_WEBSITE_CHAT_SECRET="generate-a-long-random-production-secret"

# Required in strict production. Used to encrypt stored outbound destination
# secrets. Generate a high-entropy value and keep it stable across deploys.
NORTHLINE_SECRET_ENCRYPTION_KEY="generate-a-long-random-production-key"

# Optional. Only set when Google Calendar is approved and configured.
GOOGLE_CALENDAR_CLIENT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""
GOOGLE_CALENDAR_PROJECT_ID=""
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=""
