# Future production environment template for the new Northline rebuild.
# Do not attach this to the live northline.ai project until a launch/cutover
# task is explicitly approved.

# Runtime app traffic should use the Supabase transaction pooler after an
# explicit launch/cutover plan approves the new rebuild production project.
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Prisma CLI migrations and operational tooling should use direct Postgres.
DIRECT_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"

# Set to the approved future production domain only after launch/cutover planning.
NEXT_PUBLIC_APP_URL="https://new-northline.example"

# Keep off until the new Northline rebuild has an approved launch/cutover plan.
NORTHLINE_LLM_MODE="off"
GROQ_API_KEY=""
NORTHLINE_LLM_FAST_MODEL="llama-3.1-8b-instant"
NORTHLINE_LLM_GENERATION_MODEL="llama-3.3-70b-versatile"
NORTHLINE_LLM_TIMEOUT_MS="8000"
NORTHLINE_LLM_RETRY_COUNT="1"

# Required in strict production. Used to verify signed website-chat webhooks.
NORTHLINE_WEBSITE_CHAT_SECRET="generate-a-long-random-production-secret"

# Required in strict production. Used to encrypt stored outbound destination
# secrets. Generate a high-entropy value and keep it stable across deploys.
NORTHLINE_SECRET_ENCRYPTION_KEY="generate-a-long-random-production-key"

# Optional. Only set when Google Calendar is approved and configured.
GOOGLE_CALENDAR_CLIENT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""
GOOGLE_CALENDAR_PROJECT_ID=""
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=""
