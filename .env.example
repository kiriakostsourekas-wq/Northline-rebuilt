# Local development only. Do not point this rebuild at the existing production project.
DATABASE_URL="postgresql://northline:northline@localhost:5432/northline_rebuild?schema=public"

# Prisma CLI uses DIRECT_URL for migrations and seeding. For local Postgres it
# can match DATABASE_URL. For Supabase, use the session pooler on port 5432, or
# the direct database URL only when your network supports it.
DIRECT_URL="postgresql://northline:northline@localhost:5432/northline_rebuild?schema=public"

# Vercel preview deployments should set this to the preview URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional today. Required once the browser app starts using Supabase client APIs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Local LLM orchestration.
# off = deterministic only, mock = no network, groq = real Groq provider.
# If unset, local development uses Groq when GROQ_API_KEY exists, otherwise mock.
NORTHLINE_LLM_MODE="mock"
GROQ_API_KEY=""
NORTHLINE_LLM_FAST_MODEL="llama-3.1-8b-instant"
NORTHLINE_LLM_GENERATION_MODEL="llama-3.3-70b-versatile"
NORTHLINE_LLM_TIMEOUT_MS="8000"
NORTHLINE_LLM_RETRY_COUNT="1"

# Business knowledge retrieval embeddings.
# off = lexical only, mock = no network deterministic vectors, openai = real embeddings.
NORTHLINE_EMBEDDINGS_MODE="mock"
OPENAI_API_KEY=""
NORTHLINE_EMBEDDINGS_MODEL="text-embedding-3-small"
NORTHLINE_EMBEDDINGS_DIMENSIONS="1536"
NORTHLINE_EMBEDDINGS_TIMEOUT_MS="8000"
