# Vercel Preview environment template for the new Northline rebuild only.
# Do not reuse credentials from the existing live northline.ai project.

# Runtime app traffic should use the Supabase transaction pooler in preview.
# Replace project-ref, password, and region with the values from Supabase Connect.
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI migrations and seed scripts should use Supavisor session mode on
# port 5432 when direct IPv6 is unavailable.
DIRECT_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Set to the actual Vercel preview URL before running a preview build.
NEXT_PUBLIC_APP_URL="https://northline-rebuild-preview.example"

# Optional today. Required once the browser app starts using Supabase client APIs.
NEXT_PUBLIC_SUPABASE_URL="https://project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Preview-only LLM orchestration for the new rebuild project.
# Use mock until the preview Groq key is intentionally configured.
NORTHLINE_LLM_MODE="mock"
GROQ_API_KEY=""
NORTHLINE_LLM_FAST_MODEL="llama-3.1-8b-instant"
NORTHLINE_LLM_GENERATION_MODEL="llama-3.3-70b-versatile"
NORTHLINE_LLM_TIMEOUT_MS="8000"
NORTHLINE_LLM_RETRY_COUNT="1"

# Preview-only retrieval embeddings. Keep mock until an OpenAI key is
# intentionally configured for this separate rebuild preview project.
NORTHLINE_EMBEDDINGS_MODE="mock"
OPENAI_API_KEY=""
NORTHLINE_EMBEDDINGS_MODEL="text-embedding-3-small"
NORTHLINE_EMBEDDINGS_DIMENSIONS="1536"
NORTHLINE_EMBEDDINGS_TIMEOUT_MS="8000"

# Recommended for preview website-chat webhook testing.
NORTHLINE_WEBSITE_CHAT_SECRET="generate-a-long-random-preview-secret"

# Required before testing encrypted outbound destination secrets in preview.
NORTHLINE_SECRET_ENCRYPTION_KEY="generate-a-long-random-preview-key"

# Optional. If absent, booking uses the local/mock calendar provider.
GOOGLE_CALENDAR_CLIENT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""
GOOGLE_CALENDAR_PROJECT_ID=""
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=""
